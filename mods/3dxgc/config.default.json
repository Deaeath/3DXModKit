{
  "enabled": true,

  "triggers": {
    "onBlur":      { "enabled": true,  "delaySeconds": 20 },
    "onMinimize":  { "enabled": true,  "delaySeconds": 3  },
    "onIdle":      { "enabled": true,  "idleSeconds": 180 },
    "onLowMemory": { "enabled": true },
    "onRamAmount": { "enabled": true,  "gameAboveMB": 4096, "systemFreeBelowMB": 1536, "whileFocused": true, "cooldownSeconds": 120 },
    "periodic":    { "enabled": true,  "everySeconds": 600, "onlyWhenBackgrounded": true }
  },

  "thresholds": {
    "lowMemoryPercent": 15.0,
    "criticalMemoryPercent": 8.0,
    "minWorkingSetMB": 800,
    "minSecondsBetweenTrims": 45
  },

  "systemWide": {
    "enabled": true,
    "onlyWhenCritical": true,
    "purgeStandby": true,
    "purgeLowPriorityStandby": true,
    "flushModifiedList": true,
    "emptySystemWorkingSet": false,
    "minSecondsBetweenPurges": 300,
    "whenIdle": { "enabled": true, "idleSeconds": 180, "everyMinutes": 10,
                  "emptyWorkingSets": true, "emptySystemWorkingSet": true, "flushModifiedList": true,
                  "purgeLowPriorityStandby": true, "purgeStandby": false }
  },

  "leakWatch": {
    "enabled": true,
    "everySeconds": 300,
    "heldProcesses": { "enabled": true, "warnAbove": 20000, "warnEveryMinutes": 60, "leakTest": true, "leakTestMinutes": 4, "skipFocusedTrimAboveGB": 4.0 },
    "processes":     { "enabled": true, "windowSamples": 6, "privateMBPerHour": 300, "minPrivateMB": 1024, "handlesPerHour": 2000, "minHandles": 20000, "warnEveryMinutes": 60,
                       "ignore": ["3DXChat", "System", "Idle", "Memory Compression", "Registry"] },
    "capApps":       { "enabled": true, "keepFreeGB": 0, "keepFreePercent": 25, "graceMinutes": 2, "everySeconds": 15,
                       "lowPriority": true, "spareWhilePlaying": true, "everyoneElseMB": 512, "minFactor": 0.1,
                       "apps": [
                         { "name": "Discord",           "backgroundMB": 300 },
                         { "name": "DiscordPTB",        "backgroundMB": 300 },
                         { "name": "DiscordCanary",     "backgroundMB": 300 },
                         { "name": "chrome",            "backgroundMB": 1024 },
                         { "name": "opera",             "backgroundMB": 768 },
                         { "name": "msedge",            "backgroundMB": 512 },
                         { "name": "msedgewebview2",    "backgroundMB": 256 },
                         { "name": "Code",              "backgroundMB": 600 },
                         { "name": "Spotify",           "backgroundMB": 200 },
                         { "name": "steam",             "backgroundMB": 150 },
                         { "name": "steamwebhelper",    "backgroundMB": 200 },
                         { "name": "EpicGamesLauncher", "backgroundMB": 150 },
                         { "name": "EpicWebHelper",     "backgroundMB": 150 },
                         { "name": "OneDrive",          "backgroundMB": 100 },
                         { "name": "Overwolf",          "backgroundMB": 200 },
                         { "name": "explorer",          "backgroundMB": 200 }
                       ],
                       "never": [],
                       "protect": ["3DXChat", "3DXLauncher", "dwm", "csrss", "winlogon", "sihost", "ctfmon", "fontdrvhost", "audiodg",
                                   "Memory Compression", "StartMenuExperienceHost", "ShellExperienceHost", "SearchHost", "TextInputHost",
                                   "LockApp", "Taskmgr", "SteelSeries*", "conhost"] },
    "trimApps":      { "enabled": true, "afterSeconds": 30, "againAfterMB": 64, "aboveMB": 32, "maxWaitMinutes": 30 },
    "askToRestart":  { "enabled": true, "everyMinutes": 1440, "notInFirstMinutes": 30, "whenFreeBelowPercent": 15, "whenCommitAbovePercent": 90,
                       "apps": [
                         { "name": "explorer",      "aboveMB": 1500 },
                         { "name": "Discord",       "aboveMB": 3000 },
                         { "name": "DiscordPTB",    "aboveMB": 3000 },
                         { "name": "DiscordCanary", "aboveMB": 3000 }
                       ],
                       "services": [
                         { "name": "ArmouryCrateService", "aboveHandles": 50000 }
                       ] },
    "competingOptimizers": ["WiseMemoryOptimzer", "WiseMemoryOptimizer", "MemReduct", "CleanMem", "RAMRush"]
  },

  "companions": {
    "trimLauncher": true,
    "processNames": ["3DXLauncher"]
  },

  "safety": {
    "neverTrimWhenForeground": true,
    "logEverySkip": false
  }
}
